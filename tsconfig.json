{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "core/**/*",
    "physics/**/*",
    "inventory/**/*",
    "survival/**/*",
    "world/**/*",
    "narrative/**/*",
    "tests/**/*",
    "demo.ts"
  ]
}
